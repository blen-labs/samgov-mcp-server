{
  "name": "samgov-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stateless SAM.gov opportunities MCP server with encrypted per-organization credentials",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "inspector": "node scripts/inspector.mjs",
    "inspector:cli": "node scripts/inspector.mjs --cli",
    "test:deployed": "node scripts/test-deployed.mjs",
    "manage": "tsx src/manage.ts",
    "verify": "node scripts/verify.mjs",
    "test:live-sam": "tsx scripts/live-sam.ts",
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "better-auth": "1.7.7",
    "jose": "6.2.12",
    "oidc-provider": "9.12.2",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/inspector": "2.10.1",
    "@types/node": "26.6.4",
    "@types/oidc-provider": "9.12.1",
    "@types/pg": "8.23.1",
    "tough-cookie": "6.0.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
