PUBLIC_URL=https://your-service.up.railway.app
DATABASE_URL=
# Better Auth accounts, first-party OAuth for Gemini.
AUTH_MODE=better-auth
BETTER_AUTH_SECRET=
# Google web OAuth client. Callback: PUBLIC_URL/account/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Persistent private signing key set and cookie key array, kept in host secrets.
OAUTH_SIGNING_JWKS=
OAUTH_COOKIE_KEYS=
# Optional alternative when AUTH_MODE=external:
# Tokens require issuer, audience PUBLIC_URL/mcp, subject, exp, iat,
# client_id (or azp), and space-separated scopes.
OAUTH_ISSUER=
OAUTH_JWKS_URI=
ACTIVE_ENCRYPTION_KEY_ID=v1
# JSON object mapping key IDs to 32-byte base64 keys. Store separately from DB.
ENCRYPTION_KEYS_JSON=
PORT=3000

# Optional: local direct SAM.gov API test only (scripts/live-sam.ts).
# Use the current personal API key from SAM.gov Account Details.
# The hosted server does not read this variable: tenant admins save their
# organization's key during consent, and it is encrypted in PostgreSQL.
# Keep the real value in your ignored .env; never in this example or Git.
SAM_GOV_API_KEY=
